{
  "name": "uptimeworker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --test-scheduled --persist-to ../.wrangler/state",
    "start": "wrangler dev",
    "test": "esbuild test/interval.test.ts --bundle --platform=node --format=esm --alias:cloudflare:workers=./test/cloudflare-workers.ts --external:cloudflare:sockets --outfile=node_modules/.cache/test/interval.test.mjs --log-level=warning && node node_modules/.cache/test/interval.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.54.0"
  },
  "dependencies": {
    "p-limit": "^7.3.3"
  }
}
